    "type": "dialogue",
    "speaker": "苏芮",
    "text": "好。这次换我先写信。",
    "expression": "平静",
    "version": 1
  },
  {
    "id": "es3",
    "type": "narration",
    "text": "星星一颗一颗沉进海里。夏天终于开始结束了。",
    "version": 1
  }
