<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Slide.GameLauncher</AssemblyName>
    <RootNamespace>Slide.GameLauncher</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Prefer32Bit>false</Prefer32Bit>
    <SlideBrowserMode Condition="'$(SlideBrowserMode)' == ''">cefsharp</SlideBrowserMode>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SlideBrowserMode)' == 'cefsharp'">
    <UseWindowsForms>true</UseWindowsForms>
    <DefineConstants>$(DefineConstants);SLIDE_CEFSHARP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SlideBrowserMode)' == 'system'">
    <UseWindowsForms>false</UseWindowsForms>
    <PublishSingleFile>true</PublishSingleFile>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup Condition="'$(SlideBrowserMode)' == 'cefsharp'">
    <PackageReference Include="CefSharp.WinForms.NETCore" Version="151.3.170" />
  </ItemGroup>
</Project>
