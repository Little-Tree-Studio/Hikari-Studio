{
  "name": "hikari-studio-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"for (const dir of ['dist','runtime-dist']) require('node:fs').rmSync(dir,{recursive:true,force:true})\"",
    "clean:editor": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -b && vite build && vite build --config vite.runtime.config.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "benchmark:large-project": "node --expose-gc ./node_modules/vitest/vitest.mjs run --config vitest.benchmark.config.ts --reporter=verbose",
    "test:e2e": "pnpm run build && playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "motion": "^12.23.24",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "vitest": "^4.1.10"
  }
}
